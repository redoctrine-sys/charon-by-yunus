TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ID=

# Signal server — contact maintainer for access
SIGNAL_SERVER_URL=https://api.thecharon.xyz/api
SIGNAL_SERVER_KEY=
SIGNAL_POLL_MS=30000

# Helius RPC — required for live execution; free tier works for dry_run
HELIUS_API_KEY=
SOLANA_RPC_URL=
SOLANA_WS_URL=

# GMGN enrichment — set GMGN_ENABLED=false to skip (falls back to Jupiter data)
GMGN_ENABLED=true
GMGN_API_KEY=
GMGN_REQUEST_DELAY_MS=2500
GMGN_MAX_RETRIES=2
GMGN_CACHE_TTL_MS=300000

DB_PATH=./charon.sqlite
TRADING_MODE=dry_run

# Live / confirm execution — wallet + Jupiter API key required
SOLANA_PRIVATE_KEY=
JUPITER_API_KEY=
JUPITER_SWAP_BASE_URL=https://api.jup.ag/swap/v2
LIVE_MIN_SOL_RESERVE=0.02

# LLM — any OpenAI-compatible endpoint
# Single-model mode (default): set LLM_BASE_URL + LLM_MODEL only
# Tiered router mode: also set LLM_TIER_SCREEN (activates automatic escalation)
ENABLE_LLM=true
LLM_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
LLM_API_KEY=

# Single-model fallback (used when LLM_TIER_SCREEN is NOT set)
LLM_MODEL=mimo-v2.5-pro
LLM_TIMEOUT_MS=60000
# Tier 2 (analyze) max tokens — must be large enough for a full 10-candidate JSON response
LLM_MAX_TOKENS=2500
# Tier 1 (screen) max tokens — only needs to return a confidence score, so can be smaller
LLM_SCREEN_MAX_TOKENS=800

# --- Tiered Router (optional, set LLM_TIER_SCREEN to enable) ---
# Tier 1 — fast/cheap screening
LLM_TIER_SCREEN=mimo-v2.5
# Tier 2 — mid-tier analysis, used when Tier 1 confidence < LLM_SCREEN_CONFIDENCE_THRESHOLD
LLM_TIER_ANALYZE=mimo-v2.5-pro
# Tier 3 — premium final check (optional); remove or leave blank to disable
# LLM_TIER_FINAL=mimo-v2-omni

# Escalation thresholds
LLM_SCREEN_CONFIDENCE_THRESHOLD=40
LLM_ANALYZE_CONFIDENCE_THRESHOLD=60

# Budget guard — stops LLM calls if 5-hour window spend exceeds this (USD)
LLM_BUDGET_LIMIT_USD=10

LLM_CANDIDATE_PICK_COUNT=10
LLM_CANDIDATE_MAX_AGE_MS=600000
MAX_OPEN_POSITIONS=3

MIN_FEE_CLAIM_SOL=2
GRADUATED_POLL_MS=30000
GRADUATED_LOOKBACK_MS=7200000
TRENDING_POLL_MS=60000
TRENDING_LOOKBACK_MS=600000
TRENDING_ENABLED=true
TRENDING_SOURCE=jupiter
TRENDING_ALLOW_DEGEN=false
TRENDING_INTERVAL=5m
TRENDING_LIMIT=100
TRENDING_ORDER_BY=volume
TRENDING_MIN_VOLUME_USD=0
TRENDING_MIN_SWAPS=0
TRENDING_MAX_RUG_RATIO=0.3
TRENDING_MAX_BUNDLER_RATE=0.5
GMGN_POSITION_CHECK_MS=10000
POSITION_CHECK_MS=10000
